# Copy these into Vercel: Project -> Settings -> Environment Variables.
# NEVER commit real values. For local tests, copy to .env.supabase (gitignored).

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Supabase SECRET key (sb_secret_...) — server-side only, never expose to browsers
SUPABASE_SECRET_KEY=
# Email of the founder/admin account (gets is_admin=1 on signup/login)
ADMIN_EMAIL=owner@example.com
# Long random string for session signing (any value; sessions live in DB)
SESSION_SECRET=change-me-to-a-long-random-string
